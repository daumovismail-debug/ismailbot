# --- API ключи (оставь пустыми для демо-режима) ---
# Картинки + сценарий + агенты-промптеры:
OPENAI_API_KEY=
# Анимация (Grok Imagine, image-to-video):
XAI_API_KEY=
# Озвучка:
ELEVENLABS_API_KEY=

# --- Telegram-хранилище готовых роликов (бот + канал) ---
# Создай бота у @BotFather, добавь его админом в свой канал, узнай chat_id:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Публичный адрес сервиса (ОБЯЗАТЕЛЬНО для анимации Grok) ---
# Grok скачивает наши картинки по URL. Укажи адрес сервера:
PUBLIC_BASE_URL=http://164.92.255.154:8000

# --- Картинки: Pollinations.ai (БЕСПЛАТНО, без ключей и регистрации) ---
# Основной генератор изображений. Ничего настраивать не нужно.
USE_POLLINATIONS=1
POLLINATIONS_MODEL=flux

# --- Казахский голос: edge-tts (нейроголоса Microsoft Edge, БЕСПЛАТНО) ---
# Без ключей. kk-KZ-AigulNeural (жен.) или kk-KZ-DauletNeural (муж.)
USE_EDGE_TTS=1
KZ_VOICE=kk-KZ-AigulNeural

# --- Grok-видео через ПОДПИСКУ (без API-ключа, автоматизация браузера) ---
# ВКЛЮЧАЙ только на сервере >=2 ГБ и после настройки сессии grok.com (см. README).
USE_GROK_BROWSER=0
GROK_URL=https://grok.com/imagine
# GROK_STATE_FILE=.state/grok_state.json   # файл с твоими cookies grok.com

# --- OpenClaw (ТЕКСТ через подписку ChatGPT — бесплатно) ---
# Картинки OpenClaw НЕ умеет (только текст/сценарии). Залогинь: openclaw onboard
USE_OPENCLAW=1
# Видео через OpenClaw/Grok — ВКЛЮЧАЙ только когда проверишь, что движок отвечает
# (иначе долго висит). Пока 0 → анимация = плавный зум Ken Burns.
USE_OPENCLAW_VIDEO=0
# Лимит времени на анимацию всей серии (сек) — защита от зависания видео-движка:
ANIMATE_BUDGET_SEC=480

# --- Модели (можно не трогать) ---
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
XAI_VIDEO_MODEL=grok-imagine-video
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Параметры ролика ---
SCENE_SECONDS=5
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
